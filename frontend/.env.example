# Base URL for the API. Defaults to "/api" (same-origin; the Vite dev proxy
# forwards /api and /health to the backend).
# Set this only when the API is served from a different origin,
# e.g. https://api.example.com/api
# VITE_API_BASE_URL=https://api.example.com/api

# Development only: where the Vite dev server proxies /api and /health.
# VITE_DEV_API_TARGET=http://localhost:5000
