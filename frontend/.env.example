[TEMPLATE]
# Optional: base URL for the API. Defaults to "/api" (the Vite dev proxy
# forwards /api to http://localhost:4000). Set this only when the API is
# served from a different origin, e.g. https://api.example.com/api
# VITE_API_URL=https://api.example.com/api

# DEVELOPMENT ONLY — demo/preview mode.
# Enables a simulated end-to-end flow (fake member, test OTP 123456, fake family
# and payment data) so the UI can be clicked through without PostgreSQL, an SMS
# provider, or Razorpay. Only ever active on the Vite dev server; production
# builds refuse to enable it even if this is set.
# REMOVE BEFORE PRODUCTION AUTHENTICATION IS ENABLED.
# VITE_DEMO_MODE=true