# Copy to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=5000

# Local PostgreSQL connection string
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/mitra_maheshwari

# JWT signing secret — use a long random value in production
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# Allowed frontend origin(s) for CORS, comma-separated
FRONTEND_URL=http://localhost:5173

# OTP provider: "console" prints codes to the server console in development only.
# Implement a real gateway (e.g. Twilio, MSG91, AWS SNS) in
# src/modules/auth/sms.provider.ts and set OTP_PROVIDER=sms.
OTP_PROVIDER=console
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5

# Membership fee (INR) — payment belongs to the family
MEMBERSHIP_FEE=1000
CURRENCY=INR

# Shared secret used to HMAC-sign payment webhook payloads.
# In production this must be a long random value shared with the gateway.
WEBHOOK_SECRET=replace_me_in_production