NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mitra_maheshwari
# Required secrets. Production additionally requires: ≥32 chars, no
# placeholders, CORS origins, Razorpay keys, and explicit REDIS_URL
# (startup fails loudly otherwise). OTP_HASH_SECRET / REFRESH_TOKEN_SECRET
# are optional dedicated HMAC keys (unset = fall back to JWT_SECRET).
JWT_SECRET=change-me-in-env
# OTP_HASH_SECRET=
# REFRESH_TOKEN_SECRET=
JWT_EXPIRES_IN=7d

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

MEMBERSHIP_ANNUAL_FEE_AMOUNT=1100
MEMBERSHIP_CURRENCY=INR

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Browser CORS allowlist (comma-separated exact origins, no paths).
# Empty = same-origin / non-browser use only. Production requires at least
# one https origin; non-production also allows http://localhost ports.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# Max JSON (and webhook raw) body size; oversized → 413, malformed → 400.
JSON_BODY_LIMIT=100kb
# PostgreSQL pool bounds and timeouts.
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=30000
# Graceful shutdown drain budget on SIGTERM/SIGINT.
SHUTDOWN_TIMEOUT_MS=10000

# Redis (required): shared OTP challenges + distributed rate-limit counters.
# Local dev: run `redis-server` (or `docker run -p 6379:6379 redis:7`) and
# keep the default below. Production: use the managed/hosted Redis URL with
# credentials + network rules that allow only the API instances. Use
# rediss:// (or REDIS_TLS=true) when TLS is required.
# The API fails closed (503) when Redis is unreachable: no in-memory fallback.
REDIS_URL=redis://127.0.0.1:6379
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=5000
# Trust proxy for client IPs (rate-limit keys): 'false' (default, ignore
# X-Forwarded-For), 'true', or a hop count like '1'. Enable only behind an
# explicitly trusted proxy/LB.
TRUST_PROXY=false

# OTP challenge policy
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
OTP_RESEND_WINDOW_SECONDS=3600
OTP_PROOF_TTL_SECONDS=900

# Distributed rate limits: MAX requests per WINDOW_MS window (per IP, per
# mobile, or per authenticated user depending on the endpoint; see
# src/middleware/rateLimit.ts). Exceeding returns 429 + Retry-After.
RL_OTP_REQUEST_IP_MAX=30
RL_OTP_REQUEST_IP_WINDOW_MS=900000
RL_OTP_REQUEST_MOBILE_MAX=5
RL_OTP_REQUEST_MOBILE_WINDOW_MS=900000
RL_OTP_VERIFY_IP_MAX=60
RL_OTP_VERIFY_IP_WINDOW_MS=900000
RL_OTP_VERIFY_MOBILE_MAX=10
RL_OTP_VERIFY_MOBILE_WINDOW_MS=900000
RL_REFRESH_IP_MAX=60
RL_REFRESH_IP_WINDOW_MS=900000
RL_REGISTRATION_COMPLETE_IP_MAX=10
RL_REGISTRATION_COMPLETE_IP_WINDOW_MS=3600000
RL_INVITATION_CREATE_USER_MAX=20
RL_INVITATION_CREATE_USER_WINDOW_MS=3600000
RL_INVITATION_ACCEPT_IP_MAX=20
RL_INVITATION_ACCEPT_IP_WINDOW_MS=3600000
RL_PAYMENT_ORDER_USER_MAX=10
RL_PAYMENT_ORDER_USER_WINDOW_MS=3600000
RL_CANDIDATES_IP_MAX=60
RL_CANDIDATES_IP_WINDOW_MS=900000
